{
  "datasets": [
    {
      "name": "0a7095de",
      "displayName": "EarthQuake_Query",
      "queryLines": [
        "select * from silver.earthquake_data_final"
      ],
      "catalog": "youtube_dev",
      "schema": "default"
    },
    {
      "name": "71afca69",
      "displayName": "Earthquake_type",
      "queryLines": [
        "SELECT\r\n",
        "    magnitude_bucket,\r\n",
        "    COUNT(*) AS total_magnitude\r\n",
        "FROM (\r\n",
        "    SELECT\r\n",
        "        CASE\r\n",
        "            WHEN mag < 2 THEN 'Micro (<2)'\r\n",
        "            WHEN mag >= 2 AND mag < 3 THEN 'Minor (2-3)'\r\n",
        "            WHEN mag >= 3 AND mag < 4 THEN 'Light (3-4)'\r\n",
        "            ELSE 'Moderate (4+)'\r\n",
        "        END AS magnitude_bucket\r\n",
        "    FROM youtube_dev.silver.earthquake_data_silver\r\n",
        ")\r\n",
        "GROUP BY magnitude_bucket\r\n",
        "ORDER BY magnitude_bucket;"
      ],
      "catalog": "youtube_dev",
      "schema": "silver"
    },
    {
      "name": "e7ed7e79",
      "displayName": "EarthQuake_country",
      "queryLines": [
        "SELECT\r\n",
        "    COUNT(*) AS event_count,\r\n",
        "\r\n",
        "    CASE\r\n",
        "        WHEN size(split(place, ',')) > 1\r\n",
        "            THEN trim(split(place, ',')[1])\r\n",
        "        ELSE trim(place)\r\n",
        "    END AS country\r\n",
        "\r\n",
        "FROM (\r\n",
        "    SELECT\r\n",
        "        time,\r\n",
        "        title,\r\n",
        "        mag,\r\n",
        "        longitude,\r\n",
        "        place,\r\n",
        "        latitude\r\n",
        "    FROM silver.earthquake_data_final\r\n",
        ")\r\n",
        "\r\n",
        "GROUP BY country;"
      ],
      "catalog": "youtube_dev",
      "schema": "default"
    }
  ],
